{
  "name": "Hostelworld on Roids (H.O.R)",
  "version": "0.0.0",
  "description": "Take your Hostelworld hunt from “meh” to “marvelous” — your secret weapon for hostel-hunting!",
  "homepage_url": "https://github.com/KaramanisDev/Hostelworld-On-Roids",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "js": [
        "roids.js"
      ],
      "run_at": "document_start",
      "matches": [
        "https://hostelworld.com/*",
        "https://www.hostelworld.com/*"
      ],
      "world": "MAIN"
    },
    {
      "js": [
        "content.js"
      ],
      "css": [
        "roids.css"
      ],
      "run_at": "document_start",
      "matches": [
        "https://hostelworld.com/*",
        "https://www.hostelworld.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "roids.js",
        "icons/icon32.png"
      ],
      "matches": [
        "https://hostelworld.com/*",
        "https://www.hostelworld.com/*"
      ]
    }
  ]
}
