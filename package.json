{
  "name": "hostelworld-on-roids-extension",
  "engines": {
    "npm": "^11.4.2",
    "yarn": "^4.12.0",
    "node": "^24.11.0"
  },
  "packageManager": "yarn@4.12.0",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "watch": "yarn build:dev --watch --mode=development",
    "build:prod": "webpack --config webpack.config.mjs --mode=production",
    "build:dev": "webpack --config webpack.config.mjs --mode=development",
    "lint": "yarn lint:tsc && yarn lint:eslint && yarn lint:scss && yarn lint:commit",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:eslint": "eslint \"{src,scripts}/**/*.{ts,tsx,js,mjs}\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:commit": "node scripts/commitlint.mjs",
    "crx:key": "node scripts/crx-key.mjs",
    "package:zip": "node scripts/package.mjs --type zip",
    "package:crx": "node scripts/package.mjs --type crx",
    "extension:upload": "node scripts/deploy.mjs --upload",
    "extension:publish": "node scripts/deploy.mjs --publish",
    "extension:deploy": "node scripts/deploy.mjs --upload --publish"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@commitlint/cli": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "archiver": "^8.0.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "babel-preset-solid": "^1.9.15",
    "chalk": "^6.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "crx3": "^2.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "mini-css-extract-plugin": "^2.10.2",
    "node-forge": "^1.4.0",
    "postcss": "^8.5.28",
    "sass": "^1.105.0",
    "sass-loader": "^17.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-scss": "^7.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-ext-reloader": "^1.1.13",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "ky": "^2.1.0",
    "serialize-anything": "^1.2.3",
    "solid-js": "^1.9.15"
  }
}
