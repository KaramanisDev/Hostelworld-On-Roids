{
  "name": "hostelworld-on-roids-extension",
  "engines": {
    "npm": "^11.4.2",
    "yarn": "^4.12.0",
    "node": "^24.3.0"
  },
  "packageManager": "yarn@4.12.0",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "watch": "yarn build:dev --watch --mode=development",
    "build:prod": "webpack --config webpack.config.mjs --mode=production",
    "build:dev": "webpack --config webpack.config.mjs --mode=development",
    "lint": "yarn lint:tsc && yarn lint:eslint && yarn lint:scss && yarn lint:commit",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:eslint": "eslint \"{src,scripts}/**/*.{ts,tsx,js,mjs}\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:commit": "node scripts/commitlint.mjs",
    "crx:key": "node scripts/crx-key.mjs",
    "package:zip": "node scripts/package.mjs --type zip",
    "package:crx": "node scripts/package.mjs --type crx",
    "extension:upload": "node scripts/deploy.mjs --upload",
    "extension:publish": "node scripts/deploy.mjs --publish",
    "extension:deploy": "node scripts/deploy.mjs --upload --publish"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^20.5.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.8",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "archiver": "^7.0.1",
    "babel-loader": "^10.1.1",
    "babel-preset-solid": "^1.9.15",
    "chalk": "^5.6.2",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "core-js": "^3.50.0",
    "crx3": "^2.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.12.0",
    "mini-css-extract-plugin": "^2.10.2",
    "node-forge": "^1.4.0",
    "postcss": "^8.5.28",
    "sass": "^1.105.0",
    "sass-loader": "^16.0.8",
    "stylelint": "^17.15.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-scss": "^7.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1",
    "webpack-ext-reloader": "^1.1.13",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "ky": "^1.14.3",
    "serialize-anything": "^1.2.3",
    "solid-js": "^1.9.15"
  }
}
