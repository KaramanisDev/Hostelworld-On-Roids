{
  "name": "hostelworld-on-roids-extension",
  "engines": {
    "pnpm": "^12.21.0",
    "node": "^24.11.0"
  },
  "packageManager": "pnpm@12.21.0",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "watch": "pnpm build:dev --watch",
    "build:prod": "webpack --config webpack.config.mjs --mode=production",
    "build:dev": "webpack --config webpack.config.mjs --mode=development",
    "lint": "pnpm lint:tsc && pnpm lint:eslint && pnpm lint:scss && pnpm lint:commit",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:eslint": "eslint \"{src,scripts}/**/*.{ts,tsx,js,mjs}\" \"*.{js,mjs}\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:commit": "node scripts/commitlint.mjs",
    "crx:key": "node scripts/crx-key.mjs",
    "package:zip": "node scripts/package.mjs --type zip",
    "package:crx": "node scripts/package.mjs --type crx",
    "extension:upload": "node scripts/deploy.mjs --upload",
    "extension:publish": "node scripts/deploy.mjs --publish",
    "extension:deploy": "node scripts/deploy.mjs --upload --publish"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@commitlint/cli": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/stylelint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "archiver": "^8.0.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "babel-preset-solid": "^1.9.19",
    "chalk": "^6.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.51.0",
    "crx3": "^2.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "mini-css-extract-plugin": "^2.10.2",
    "node-forge": "^1.4.3",
    "postcss": "^8.5.33",
    "postcss-scss": "^4.0.9",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "stylelint": "^18.0.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-scss": "^7.5.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "ws": "^8.23.0",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "ky": "^2.2.0",
    "serialize-anything": "^1.2.3",
    "solid-js": "^1.9.19"
  }
}
